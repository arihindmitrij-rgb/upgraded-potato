# --- Wildberries ---
# Ключ со стандартным доступом: категории «Контент» + «Поставки»
WB_API_KEY_STANDARD=

# --- Ozon Seller API ---
# Client-Id и Api-Key из ЛК Ozon → Seller API (ИП Баранов)
OZON_CLIENT_ID=
OZON_API_KEY=
# Точка отгрузки для multi-cluster черновика (/v1/warehouse/fbo/list)
OZON_DROP_OFF_WAREHOUSE_ID=
OZON_REPORT_PREFIX=ИП Баранов Озон
OZON_DESTINATION_MARKER=Озон
OZON_REPORT_DIR=C:\Users\User\Desktop\ТЗ Ozon
# OZON_TEMPLATE_PATH=C:\Users\User\Desktop\ИП Баранов Озон.xlsx
# OZON_API_BASE=https://api-seller.ozon.ru

# --- Google Sheets ---
SPREADSHEET_ID=1maPS53UdNFe4MCVquAq_ZUYqz5BtMLIC
# gid листа «Проверочный лист(Дима)». Для обычного запуска не нужен:
# берётся самый свежий «Баранов ВБ …» / «Баранов ОЗОН …».
SHEET_GID=696867362
SHEET_NAME=Проверочный лист (Дима)

# --- Данные для ТЗ фулфилмента ---
SUPPORT_PHONE=+7-903-197-76-15
SELLER_NAME=ИП Баранов Н.В.
BRAND=
# Что печатаем в строке «На какой склад требуется отгрузка»
DESTINATION_MARKER=ВБ

# --- Куда складывать ТЗ для ФФ ---
# Папка на рабочем столе; имя файла = REPORT_PREFIX + дата
REPORT_DIR=C:\Users\User\Desktop\ТЗ WB
REPORT_PREFIX=ИП Баранов ВБ
REPORT_DATE_FORMAT=%d.%m.%Y

# --- Telegram ---
# Бот @fbsxoradobot; ответы идут в личку тому, кто написал
TELEGRAM_BOT_TOKEN=

# --- Прочее ---
OUTPUT_DIR=output
CACHE_DIR=.cache
HTTP_TIMEOUT=30
CACHE_TTL_MIN=30

# --- Автораспределение / МойСклад / heartbeat ---
MOYSKLAD_TOKEN=
AUTODIST_HISTORY_DAYS=35
AUTODIST_COVER_CEILING_DAYS=42
AUTODIST_OZON_MIN_COVER_DAYS=14
AUTODIST_OZON_MIN_NEED=1
AUTODIST_SEASON_MIN=0.7
AUTODIST_SEASON_MAX=1.3
AUTODIST_DRY_RUN=0
AUTODIST_WB_WAREHOUSE=СЦ Домодедово 2
# Удобнее править пороги в autodist_config.json (оверрайд .env) — см. Hub «Почему так»
WORKER_HEARTBEAT_PATH=
HUB_HEARTBEAT_PATH=
WORKER_HEARTBEAT_STALE_SEC=90
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: path to Desktop client JSON (credentials.json). Else ID/SECRET above.
# GOOGLE_OAUTH_CLIENT_SECRETS=credentials.json
# Local redirect for bootstrap (must match Console if Web client): http://localhost:8080/
# GOOGLE_OAUTH_LOCAL_PORT=8080
GOOGLE_TOKEN_PATH=.cache/google_token.json
N8N_BASE_URL=
N8N_API_TOKEN=
APIMIRA_API_KEY=
